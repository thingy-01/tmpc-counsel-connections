# Clerk Authentication
# In development, Clerk runs in "keyless mode" — keys are auto-generated.
# These are OPTIONAL for local dev but REQUIRED for production deployment.
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_REPLACE_ME
# CLERK_SECRET_KEY=sk_test_REPLACE_ME
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
# After sign-in/up, send users to the portal (admins are redirected to /admin by middleware).
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/portal
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/portal
#
# Admin access uses Clerk Organizations: create one TMCP organization in the Clerk
# dashboard, enable Organizations, and give staff the built-in "org:admin" role.
# Companies link to their DB record via their invite code (the claim flow at /portal).

# Database
# Production (Neon): postgresql://user:password@host.neon.tech/db?sslmode=require
# Local dev: any Postgres works too, e.g. postgresql://postgres@127.0.0.1:5432/tmpc
# (non-neon.tech URLs automatically use the node-postgres driver)
DATABASE_URL=postgresql://user:password@host.neon.tech/tmpc_counsel_connections?sslmode=require

# Local development WITHOUT Clerk keys (never active in production builds):
#   DEV_AUTH=admin            browse as a TMCP admin
#   DEV_AUTH=company          browse as the first company in the DB
#   DEV_AUTH=company:<uuid>   browse as a specific company
# DEV_AUTH=admin

# Resume file storage (PDFs).
# Production: point at a mounted Railway Volume, e.g. /data/resumes.
# Local dev: defaults to ./.uploads/resumes if unset.
RESUME_STORAGE_DIR=/data/resumes

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
