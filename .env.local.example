# ── Authentication ────────────────────────────────────────────────────────
# Two separate logins:
#   • TMCP staff/admins  -> Clerk (only admins need email-verified accounts)
#   • Companies/interviewees -> email-free invite-code login (no Clerk, no email)
#
# Clerk is REQUIRED only for the /admin area. Admin access uses Clerk
# Organizations: enable Organizations, create the TMCP org, and give staff the
# built-in "org:admin" role.
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_REPLACE_ME
# CLERK_SECRET_KEY=sk_test_REPLACE_ME
# Required in production. Only org:admin members of this exact organization
# can use staff routes.
# CLERK_ADMIN_ORG_ID=org_REPLACE_ME
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/admin
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/admin
#
# Secret used to sign the company invite-code session cookie. OPTIONAL: if unset,
# CLERK_SECRET_KEY is used (so production works with no extra config). Set this if
# you want company sessions to survive a Clerk key rotation.
# SESSION_SECRET=change-me-to-a-long-random-string

# Required in production for the independent attorney portal. Use at least 32
# random bytes. This secret signs attorney session cookies.
# ATTORNEY_SESSION_SECRET=replace-with-at-least-32-random-bytes

# Attorney login and schedule email. Production supports Resend. The capture
# transport writes local test artifacts and refuses to run in production.
# ATTORNEY_EMAIL_TRANSPORT=resend
# ATTORNEY_EMAIL_FROM=Counsel Connections <schedule@verified.example.org>
# RESEND_API_KEY=re_REPLACE_ME

# Database
# Production (Neon): postgresql://user:password@host.neon.tech/db?sslmode=require
# Local dev: any Postgres works too, e.g. postgresql://postgres@127.0.0.1:5432/tmpc
# (non-neon.tech URLs automatically use the node-postgres driver)
DATABASE_URL=postgresql://user:password@host.neon.tech/tmpc_counsel_connections?sslmode=require

# Local development WITHOUT Clerk keys (never active in production builds):
#   DEV_AUTH=admin            browse as a TMCP admin
#   DEV_AUTH=company          browse as the first company in the DB
#   DEV_AUTH=company:<uuid>   browse as a specific company
# DEV_AUTH=admin

# Resume file storage (PDFs).
# Production: point at a mounted Railway Volume, e.g. /data/resumes.
# Local dev: defaults to ./.uploads/resumes if unset.
RESUME_STORAGE_DIR=/data/resumes

# Canonical app URL. Production must use https and the public site origin.
NEXT_PUBLIC_APP_URL=http://localhost:3000
